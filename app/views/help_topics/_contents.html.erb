<%# without the guide, the contents say so first (docs/setup.md); the other plugins' and the operator's sections follow %>
<% if !@guide %>
  <p class="nodata"><%= l(:text_help_guide_missing) %></p>
<% elsif @sections.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
<% @sections.each do |section| %>
  <h3><%= section.title(@language) %></h3>
  <ul>
    <% section.topics.each do |topic| %>
      <li><%= link_to section.topic_title(topic, @language), help_topic_path(topic.id, lang: params[:lang].presence) %></li>
    <% end %>
  </ul>
<% end %>
