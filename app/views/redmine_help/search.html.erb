<h2><%= l(:label_search) %></h2>

<%= form_tag(help_search_path, method: :get, id: 'search-form') do %>
  <div class="box">
    <%= hidden_field_tag 'lang', params[:lang] if params[:lang].present? %>
    <%= label_tag 'search-input', l(:description_search), class: 'hidden-for-sighted' %>
    <p><%= text_field_tag 'q', @query, size: 60, id: 'search-input' %></p>
  </div>
  <p><%= submit_tag l(:label_search), name: nil %></p>
<% end %>

<% if @query.present? %>
  <h3><%= l(:label_result_plural) %> (<%= @results.size %>)</h3>
  <% if @results.empty? %>
    <p class="nodata"><%= l(:label_no_data) %></p>
  <% else %>
    <dl id="search-results">
      <% @results.each do |topic, snippet| %>
        <dt class="wiki-page icon icon-wiki-page">
          <%= sprite_icon('wiki-page') %>
          <%= link_to help_title(topic), help_topic_path(topic.id, lang: params[:lang].presence) %>
        </dt>
        <dd><span class="description"><%= snippet %></span></dd>
      <% end %>
    </dl>
  <% end %>
<% end %>

<% content_for :sidebar do %>
  <%= render partial: 'redmine_help/sidebar' %>
<% end %>
<% html_title(l(:label_search), l(:label_help)) %>
