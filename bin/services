#!/usr/bin/env bash
# Starts PostgreSQL 16 and headless Chromium for the tests, or stops them with
# --down.
set -euo pipefail
cd "$(dirname "$0")/.."
compose=(docker compose -f test/compose.yml -p redmine-help-test --profile browser)
if [[ "${1:-}" == "--down" ]]; then
  "${compose[@]}" down -v
  exit 0
fi
"${compose[@]}" up -d --wait
