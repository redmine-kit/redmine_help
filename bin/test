#!/usr/bin/env bash
# The plugin's tests in Redmine 7.0.3 on PostgreSQL 16, in Docker.
#   bin/test              # the plugin's tests
#   bin/test --redmine    # also every Redmine test, with the plugin installed
#   bin/test <files>      # some files of the plugin's tests
#   REDMINE_BRANCH=master bin/test   # on Redmine's master branch
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
image=redmine-help-test${REDMINE_BRANCH:+-$REDMINE_BRANCH}
bin/services >/dev/null
docker buildx build --load -q -t "$image" --build-arg REDMINE_BRANCH="${REDMINE_BRANCH:-}" -f test/Dockerfile . >/dev/null
run() {
  docker run --rm --network redmine-help-test_default -e PARALLEL_WORKERS="${PARALLEL_WORKERS:-4}" "$image" \
    sh -c 'bin/rails db:drop db:create db:migrate db:schema:dump >/dev/null && "$@"' test "$@"
}
# The plugin's tests, one process: the system tests (test/system) drive the
# Chromium of bin/services, which opens this container's test server by its
# network alias. PLUGIN_COVERAGE=1 writes coverage/coverage.xml.
run_plugin() {
  mkdir -p coverage
  docker run --rm --network redmine-help-test_default --network-alias redmine-test \
    -e SELENIUM_REMOTE_URL=http://chrome:4444 -e CAPYBARA_SERVER_HOST=0.0.0.0 -e CAPYBARA_SERVER_PORT=3001 \
    -e CAPYBARA_APP_HOST=http://redmine-test:3001 -e GOOGLE_CHROME_OPTS_ARGS=--headless=new \
    -e PLUGIN_COVERAGE="${PLUGIN_COVERAGE:-}" -e PARALLEL_WORKERS=1 \
    -v "$PWD/coverage:/redmine/plugins/redmine_help/coverage" "$image" \
    sh -c 'bin/rails db:drop db:create db:migrate db:schema:dump >/dev/null && "$@"' test "$@"
}
# Redmine's tests that fail with the current gems for known reasons.
known=$(grep -v -e '^#' -e '^$' test/redmine_known_failures.txt | sed 's/[.]/\\./g' | paste -sd '|' -)
if [[ "${1:-}" == "--redmine" ]]; then
  PLUGIN_COVERAGE=1 run_plugin bin/rails test plugins/redmine_help/test
  run bin/rails test --exclude "/^($known)\$/"
elif (($#)); then
  run_plugin bin/rails test "${@/#/plugins/redmine_help/}"
else
  PLUGIN_COVERAGE=1 run_plugin bin/rails test plugins/redmine_help/test
fi
