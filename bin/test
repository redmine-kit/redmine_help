#!/usr/bin/env bash
# The plugin's tests in Redmine 7.0.3 on PostgreSQL 16, in Apple container when
# it runs, else in Docker (CONTAINER_CLI=container|docker chooses).
#   bin/test              # the plugin's tests
#   bin/test --redmine    # also every Redmine test, with the plugin installed
#   bin/test <files>      # some files of the plugin's tests
#   REDMINE_BRANCH=master bin/test   # on Redmine's master branch
#   COVERAGE=1 bin/test   # with the plugin's coverage in coverage/coverage.xml, as the CI does
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
image=redmine-kit-help-test${REDMINE_BRANCH:+-$REDMINE_BRANCH}
source bin/container_cli
bin/services >/dev/null
address() { container inspect "$1" | sed -n 's/.*"ipv4Address" : "\([0-9.]*\)\/.*/\1/p' | head -1; }
if [[ "$cli" == docker ]]; then
  # The services by their names on the network of test/compose.yml; Chromium
  # opens this container's test server by its network alias.
  opts=(--network redmine-kit-help-test_default --network-alias redmine-test)
  selenium=http://chrome:4444
  app_host='http://redmine-test:3001'
  chrome_args=--headless=new
  docker buildx build --load -q -t "$image" --build-arg REDMINE_BRANCH="${REDMINE_BRANCH:-}" -f test/Dockerfile . >/dev/null
else
  # Apple container (bin/services): the services by their addresses, since
  # containers don't find each other by name on a network of their own, and
  # the test server by this container's own address. More memory than the
  # 1 GB a container gets by default, for the parallel workers.
  opts=(--network redmine-kit-help-test -m 4G -e TEST_DATABASE_HOST="$(address redmine-kit-help-test-postgres)")
  selenium="http://$(address redmine-kit-help-test-chrome):4444"
  app_host='http://$(ruby -rsocket -e "print Socket.ip_address_list.find(&:ipv4_private?).ip_address"):3001'
  chrome_args=--headless=new,--disable-dev-shm-usage
  # The build's log only when it fails (`container build -q` doesn't return).
  log=$(mktemp)
  container build --progress plain -t "$image" --build-arg REDMINE_BRANCH="${REDMINE_BRANCH:-}" -f test/Dockerfile . >"$log" 2>&1 ||
    { cat "$log" >&2; exit 1; }
  rm -f "$log"
fi
# A database of this run's own (test/database.yml reads TEST_DATABASE): runs at
# the same time share the PostgreSQL container. Dropped when the tests end.
db="redmine_test_$$"
setup='bin/rails db:drop db:create db:migrate db:schema:dump >/dev/null'
teardown='; status=$?; bin/rails db:drop >/dev/null 2>&1; exit $status'
run() {
  "$cli" run --rm "${opts[@]}" -e TEST_DATABASE="$db" -e PARALLEL_WORKERS="${PARALLEL_WORKERS:-4}" "$image" \
    sh -c "$setup"' && "$@"'"$teardown" test "$@"
}
# The plugin's tests, one process: the system tests (test/system) drive the
# Chromium of bin/services, which opens this container's test server. With
# COVERAGE set, the coverage is written to coverage/coverage.xml
# (test/test_helper.rb). COVERAGE itself is not passed on: Redmine's test
# helper would start a SimpleCov of its own.
run_plugin() {
  local cov=()
  if [[ -n "${COVERAGE:-}" ]]; then
    rm -f coverage/.resultset.json && mkdir -p coverage
    cov=(-e PLUGIN_COVERAGE=1 -v "$PWD/coverage:/redmine/plugins/redmine_kit_help/coverage")
  fi
  "$cli" run --rm "${opts[@]}" ${cov[@]+"${cov[@]}"} -e TEST_DATABASE="$db" \
    -e SELENIUM_REMOTE_URL="$selenium" -e CAPYBARA_SERVER_HOST=0.0.0.0 -e CAPYBARA_SERVER_PORT=3001 \
    -e GOOGLE_CHROME_OPTS_ARGS="$chrome_args" -e PARALLEL_WORKERS=1 "$image" \
    sh -c "$setup"' && CAPYBARA_APP_HOST='"$app_host"' "$@"'"$teardown" test "$@"
}
# Redmine's tests that fail with the current gems for known reasons.
known=$(grep -v -e '^#' -e '^$' test/redmine_known_failures.txt | sed 's/[.]/\\./g' | paste -sd '|' -)
if [[ "${1:-}" == "--redmine" ]]; then
  run_plugin bin/rails test plugins/redmine_kit_help/test
  run bin/rails test --exclude "/^($known)\$/"
elif (($#)); then
  run_plugin bin/rails test "${@/#/plugins/redmine_kit_help/}"
else
  run_plugin bin/rails test plugins/redmine_kit_help/test
fi
